# --- Обязательное ---
DISCORD_TOKEN=
DISCORD_BOT_OWNER_ID=
DISCORD_SERVER_FOR_EXPORT_ID=
VM_OUTPUT_DEVICE=            # ТОЧНОЕ имя виртуального выхода Voicemeeter (см. Windows -> Звук)
                              # Banana: "Voicemeeter Out B2 (VB-Audio Voicemeeter VAIO)"

# --- Опционально: AHK-мост ---
BRIDGE_TOKEN=

# --- Voicemeeter ---
VM_DLL_PATH=                 # если пусто — автопоиск по типичным путям (обычный/Banana/Potato, с (x86) и без)
VM_STRIP_INDEX=7
# -60/12 — это НЕ произвольная настройка, а собственные пределы фейдера
# Voicemeeter. Трогай, только если хочешь сузить диапазон бота внутри них.
VM_MIN_DB=-60.0
VM_MAX_DB=12.0
VOLUME_CEILING_DEFAULT=-4.0
VOLUME_STEP_DB=2.0
FADE_STEP_DB=0.5
FADE_MAX_STEPS=20
FADE_STEP_DELAY_SECONDS=0.05

# --- Discord-бот ---
COMMAND_PREFIX=!
DEFAULT_LOCALE=ru             # ru | default(en) — язык fallback-сообщений вне слэш-команд
PRESENCE_UPDATE_INTERVAL_SECONDS=15
EMBED_COLOR=1DB954             # hex без #, цвет embed'а /now

# --- Spotify (для НЕ-русского клиента добавь свои заголовки-заглушки) ---
SPOTIFY_IDLE_TITLES_EXTRA=

# --- Веб-мост (AHK <-> Python) ---
WEB_HOST=127.0.0.1
WEB_PORT=5000

# --- ffmpeg для радио-стрима (при желании подстроить под своё железо/сеть) ---
FFMPEG_BEFORE_ARGS=-f dshow -rtbufsize 100M -audio_buffer_size 50
FFMPEG_AFTER_ARGS=-vn -ac 2 -ar 48000 -threads 1 -preset ultrafast -tune zerolatency
